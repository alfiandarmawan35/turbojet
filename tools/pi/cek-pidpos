#!/usr/bin/env bash
# Ringkasan status agen PID POS di Pi. HANYA MEMBACA (tidak mengubah apa pun).
D=~/work/proyek/pid_pos_tj
cd "$D" || exit 1
echo "== Layanan: $(systemctl --user is-active pidpos-agen) / $(systemctl --user is-enabled pidpos-agen)  | sejak: $(systemctl --user show pidpos-agen -p ActiveEnterTimestamp --value)"
P=$(pgrep -f "claude -p Kamu bekerja mandiri" | head -1)
[ -n "$P" ] && echo "== Claude bekerja: pid $P, lama putaran $(ps -o etime= -p $P | tr -d ' ')" || echo "== Claude: tidak sedang jalan (jeda/berhenti)"
[ -f .agen/STOP ] && echo "!! .agen/STOP ada (agen akan berhenti)"
echo; echo "== agen.log (8 baris terakhir)"; tail -8 .agen/agen.log 2>/dev/null
echo; echo "== Git: $(git branch --show-current) | belum di-commit: $(git status --porcelain | wc -l) berkas"
git log --oneline -8 origin/master..HEAD 2>/dev/null
echo "terakhir di GitHub: $(git log -1 --format='%h %cr — %s' origin/pid-pos-lengkap 2>/dev/null || echo 'belum ada push')"
echo; T=$(grep -c '^| \[x\]' kontrak/DAFTAR_ENDPOINT_65.md); M=$(grep -c '^| \[-\]' kontrak/DAFTAR_ENDPOINT_65.md)
echo "== Endpoint: $T selesai, $M ditandai mustahil, dari 369"
echo; echo "== PROGRES.md"; sed -n '1,60p' PROGRES.md
echo; echo "== Kontainer bench"; docker ps --format '{{.Names}}  {{.Status}}' 2>/dev/null | grep pid_pos || echo "(tidak ada)"
echo; echo "== Aktivitas terakhir Claude (10 aksi)"
J=$(ls -t ~/.claude/projects/-home-ubuntu-work-proyek-pid-pos-tj/*.jsonl 2>/dev/null | head -1)
[ -n "$J" ] && python3 - "$J" <<'PY'
import json,sys
from datetime import datetime,timedelta
def w(t):
    try: return (datetime.fromisoformat(t.replace("Z","+00:00"))+timedelta(hours=7)).strftime("%H:%M:%S")
    except Exception: return "--:--:--"
acts=[]
for line in open(sys.argv[1],encoding="utf-8",errors="replace"):
    try: d=json.loads(line)
    except Exception: continue
    m=d.get("message") or {}
    if d.get("type")!="assistant" or not isinstance(m.get("content"),list): continue
    for c in m["content"]:
        if c.get("type")=="tool_use":
            i=c.get("input",{}); s=i.get("description") or i.get("command") or i.get("file_path") or i.get("pattern") or ""
            acts.append(f'{w(d.get("timestamp",""))} {c["name"]}: {str(s).splitlines()[0][:110] if s else ""}')
        elif c.get("type")=="text" and c.get("text","").strip():
            acts.append(f'{w(d.get("timestamp",""))} (teks) {c["text"].strip().splitlines()[0][:110]}')
print("\n".join(acts[-10:]) or "(belum ada)")
PY
