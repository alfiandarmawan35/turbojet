# ~/.config/agen/<nama>.env  — setelan satu agen (dibaca layanan agen@<nama> dan cek-agen <nama>)
AGEN_DIR=/home/USER/work/proyek/nama_app      # folder repo app (wajib)
AGEN_BRIEF=TUGAS.md                           # brief tugas, relatif terhadap AGEN_DIR
AGEN_PROGRES=PROGRES.md                       # ingatan antar-sesi; berisi baris "STATUS: SELESAI" bila tuntas
AGEN_BRANCH=agen                              # branch kerja (jangan main/master)
# AGEN_CHECKLIST=docs/DAFTAR.md               # opsional: daftar centang "| [x] |" untuk hitungan kemajuan
# AGEN_MODEL=sonnet                           # opsional: model Claude Code (bawaan = setelan Claude Code)
# AGEN_MAKS_PUTARAN=300
# AGEN_JEDA_LIMIT=1800                        # detik jeda bila kena limit/kuota
# AGEN_IZIN=bypassPermissions                 # mode izin Claude Code
# AGEN_PROMPT="..."                           # opsional: ganti prompt bawaan
